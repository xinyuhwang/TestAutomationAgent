{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/eval-report.schema.json",
  "title": "EvalReport",
  "description": "Full output of one agent run: metadata, budget outcome, findings, and new/known/regression classification against the baseline findings.json (design-doc §12, §16).",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "trigger", "app_type", "status", "findings"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },

    "trigger": {
      "type": "string",
      "enum": ["pr", "scheduled", "manual"]
    },

    "app_type": {
      "type": "string",
      "enum": ["traditional", "agentic"]
    },

    "fixture_id": {
      "type": "string",
      "description": "Set only when the run targeted a fixture app from the evaluation harness (design-doc §14), so the scorer knows which ground truth to score against. Absent for runs against real repositories.",
      "minLength": 1
    },

    "status": {
      "type": "string",
      "description": "Overall run outcome. budget_exhausted is first-class, not an error (design-doc §9).",
      "enum": ["completed", "budget_exhausted", "error"]
    },

    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_steps": { "type": "integer", "minimum": 1 },
        "max_llm_calls": { "type": "integer", "minimum": 1 },
        "max_runtime_seconds": { "type": "integer", "minimum": 1 },
        "max_test_cases": { "type": "integer", "minimum": 1 },
        "max_retries": { "type": "integer", "minimum": 0 },
        "max_cost_usd": { "type": "number", "minimum": 0 },
        "used": {
          "type": "object",
          "description": "Actuals, for observability (design-doc §10).",
          "additionalProperties": false,
          "properties": {
            "steps": { "type": "integer", "minimum": 0 },
            "llm_calls": { "type": "integer", "minimum": 0 },
            "runtime_seconds": { "type": "number", "minimum": 0 },
            "test_cases": { "type": "integer", "minimum": 0 },
            "retries": { "type": "integer", "minimum": 0 },
            "cost_usd": { "type": "number", "minimum": 0 },
            "unmeasured": {
              "type": "array",
              "description": "Counters this run could not observe. Without this, an absent cost_usd is indistinguishable from a run that genuinely cost nothing — so a missing counter must be declared rather than defaulted to zero.",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["steps", "llm_calls", "runtime_seconds", "test_cases", "retries", "cost_usd"]
              }
            }
          }
        }
      }
    },

    "skill_spans": {
      "type": "array",
      "description": "Per-skill breakdown of one run (design-doc §10). Flat budget.used totals cannot answer 'which skill triggered the retry loop' or 'how many tests were generated but never executed'; these spans can.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "status"],
        "properties": {
          "skill": {
            "type": "string",
            "enum": [
              "test-case-generation",
              "adversarial-testing",
              "defect-to-architecture-tracing",
              "security-review",
              "integration-coordination",
              "eval-doc-generation"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["completed", "budget_exhausted", "error"]
          },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "llm_calls": { "type": "integer", "minimum": 0 },
          "tokens_in": { "type": "integer", "minimum": 0 },
          "tokens_out": { "type": "integer", "minimum": 0 },
          "cost_usd": { "type": "number", "minimum": 0 },

          "tool_calls": {
            "type": "array",
            "description": "Retry counts live here, which is what makes a retry loop attributable to a specific skill.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["tool"],
              "properties": {
                "tool": { "type": "string", "minLength": 1 },
                "summary": { "type": "string", "minLength": 1 },
                "retries": { "type": "integer", "minimum": 0 },
                "duration_seconds": { "type": "number", "minimum": 0 }
              }
            }
          },

          "tests_generated": {
            "type": "integer",
            "description": "Tests this skill produced. Compare against tests_executed: a gap means tests were generated and never run, which is a silent failure mode rather than a smaller bill.",
            "minimum": 0
          },
          "tests_executed": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["test_id", "result"],
              "properties": {
                "test_id": { "type": "string", "minLength": 1 },
                "result": {
                  "type": "string",
                  "enum": ["passed", "failed", "error", "skipped"]
                },
                "repetitions": { "type": "integer", "minimum": 1 },
                "failures": { "type": "integer", "minimum": 0 },
                "duration_seconds": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    },

    "findings": {
      "type": "array",
      "items": { "$ref": "finding.schema.json" }
    },

    "diff_summary": {
      "type": "object",
      "description": "New/known/regression classification against the prior findings.json baseline for this repo (design-doc §16).",
      "additionalProperties": false,
      "properties": {
        "new": { "type": "array", "items": { "type": "string" }, "description": "Finding ids not present in baseline." },
        "known": { "type": "array", "items": { "type": "string" }, "description": "Finding ids matching baseline, unresolved." },
        "regression": { "type": "array", "items": { "type": "string" }, "description": "Finding ids previously marked resolved, now reappearing." },
        "resolved": { "type": "array", "items": { "type": "string" }, "description": "Baseline finding ids not reproduced this run." }
      }
    }
  }
}
